generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentMode {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  CASH
  NETBANKING
}

enum LendingType {
  GIVEN
  BORROWED
  EMI
}

enum LendingStatus {
  PENDING
  PARTIAL
  SETTLED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  passwordHash  String?  // null for Google / demo users, same as db.passwords[userId] today
  monthlyBudget Float?
  createdAt     DateTime @default(now())
  lastModifiedAt DateTime @updatedAt // replaces the in-memory touchUser/getLastModifiedAt map

  transactions  Transaction[]
  lendings      Lending[]
  subscriptions Subscription[]
  todos         Todo[]
  goals         Goal[]

  @@map("users")
}

model Category {
  id            String   @id
  name          String
  icon          String
  isDefault     Boolean  @default(true)

  subcategories Subcategory[]
  transactions  Transaction[]
  subscriptions Subscription[]

  @@map("categories")
}

model Subcategory {
  id         String   @id
  categoryId String
  name       String

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  subscriptions Subscription[]

  @@unique([categoryId, name])
  @@map("subcategories")
}

model Transaction {
  id            String      @id
  userId        String
  categoryId    String
  subcategoryId String?
  amount        Float
  paymentMode   PaymentMode
  date          String // kept as YYYY-MM-DD text to match existing string-sort logic
  description   String?
  tags          String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id])
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@map("transactions")
}

model Lending {
  id                String        @id
  userId            String
  personName        String
  amount            Float
  type              LendingType
  dueDate           String?
  status            LendingStatus @default(PENDING)
  installmentNo     Int?
  totalInstallments Int?
  notes             String?
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lendings")
}

model Subscription {
  id              String             @id
  userId          String
  name            String
  amount          Float
  categoryId      String
  subcategoryId   String?
  billingDay      Int
  paymentMode     PaymentMode
  status          SubscriptionStatus @default(ACTIVE)
  startDate       String
  lastBilledDate  String?
  nextBillingDate String
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id])
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("subscriptions")
}

model Todo {
  id          String   @id
  userId      String
  date        String
  title       String
  description String?
  isDone      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("todos")
}

model Goal {
  id           String     @id
  userId       String
  title        String
  targetValue  Float
  currentValue Float      @default(0)
  deadline     String?
  status       GoalStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}
