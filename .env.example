# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Client ID for Google OAuth / Google Sign-In
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# GOOGLE_CLIENT_SECRET: Client Secret for Google OAuth
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# SUPABASE_URL: URL for your Supabase project (e.g. https://xyz.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Public Anon Key for Supabase
SUPABASE_ANON_KEY="your-supabase-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Service Role Key for Supabase Admin operations
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# DATABASE_URL: Direct PostgreSQL Connection String for Supabase DB
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# JWT_SECRET: Secret used to sign JSON Web Tokens
JWT_SECRET="your-jwt-secret-key"

